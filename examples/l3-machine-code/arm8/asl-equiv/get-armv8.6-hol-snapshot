#!/usr/bin/env bash
set -e
hol_root=$(git rev-parse --show-toplevel)
git -C "$hol_root" submodule update --init -- examples/l3-machine-code/arm8/asl-equiv/armv8.6-asl-snapshot
cd armv8.6-asl-snapshot

# Disable the large pretty-printed doc comment in armv86aTheory.sig.
# Without this the generated .sig is ~1.3 GB, which trips a 32-bit Int
# overflow in the MLton-built Holmake during dependency analysis.
script=A64_ISA_v86A/armv86aScript.sml
if ! grep -q '"TheoryPP.include_html_docs"' "$script"; then
    perl -i -pe 'print "val _ = Feedback.set_trace \"TheoryPP.include_html_docs\" 0;\n" if /^val _ = export_theory\(\)/' "$script"
fi
